# Canlı ortam değişkenleri — `docker-compose.prod.yml` bunu okur.
#
#   cp .env.prod.example .env.prod
#   nano .env.prod
#   chmod 600 .env.prod        ← içinde Stripe anahtarı var, herkes okumasın
#
# .env.prod repoya GİRMEZ (.gitignore). Sunucuda durur, yedeklenir.
#
# Rastgele gizli anahtar üretmek için:
#   openssl rand -hex 32

# ------------------------------------------------------------------ alan adı
# DNS'te bu adın A kaydı sunucunun IP'sini göstermeli. Caddy sertifikayı buna
# göre alır; yanlışsa TLS el sıkışması hiç kurulmaz.
DOMAIN=samisdoener.de
# Let's Encrypt sertifika bitiş uyarılarını buraya gönderir.
LETSENCRYPT_EMAIL=

# --------------------------------------------------------------- veritabanı
# Postgres kabının parolası. Bir kez belirlenir; sonradan değiştirmek için
# veritabanı kabına girip parolayı elle güncellemek gerekir.
POSTGRES_PASSWORD=

# İlk kurulumda "true" yapın: boş veritabanına menü ve işletme bilgisi yazılır.
# İlk açılıştan sonra MUTLAKA "false" yapın — aksi hâlde her dağıtımda menü
# dosyadaki hâline geri döner ve panelden yapılan değişiklikler silinir.
SEED_ON_START=false

# ----------------------------------------------------------- gizli anahtarlar
# ADMIN_PASSWORD kalıcı bir giriş parolası DEĞİL, kurulum anahtarıdır: panelde
# hiç sahip hesabı yokken çalışır, işletmeci kendi hesabını açınca kendiliğinden
# kapanır. Rastgele bir değer koyun ve işletmeciye yalnızca ilk giriş için verin.
# Kilitlenme hâlinde geçici olarak açmak için: ADMIN_RECOVERY=1 (iş bitince silin).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ORDER_TOKEN_SECRET=
CUSTOMER_SESSION_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------- ödeme
# Canlıda sk_live_ ile başlar. Webhook adresi Stripe panelinde şu olmalı:
#   https://<DOMAIN>/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------------------- e-posta
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
ORDER_MAIL_FROM=

# ----------------------------------------------------------- yasal (Impressum)
# Boş bırakılırsa /impressum sayfası kırmızı uyarı gösterir ve site fiilen
# Impressum'suz sayılır (Abmahnung riski). Canlıya çıkmadan önce doldurulmalı.
LEGAL_COMPANY_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_CONTACT_EMAIL=
LEGAL_VAT_ID=
LEGAL_SUPERVISORY_AUTHORITY=
LEGAL_PRIVACY_CONTACT=
LEGAL_REGISTER_ENTRY=

# ------------------------------------------------------------------ yedek
# Sunucudaki ./backups dizininde kaç günlük yedek tutulacağı.
BACKUP_KEEP_DAYS=14

# Yedeklerin kopyalanacağı UZAK hedef (rclone söz dizimi: "<remote>:<yol>").
#
# BOŞ BIRAKILIRSA yedek yalnızca sunucunun kendi diskinde durur — disk giderse
# yedek de gider. Canlıda doldurulmalı.
#
# Kurulum: deploy/backup-secrets/rclone.conf dosyasını oluşturun
# (bkz. deploy/README.md → "Yedek"). İki yaygın seçenek:
#
#   Hetzner Storage Box (~3,5 €/ay, 1 TB, Almanya):
#     BACKUP_REMOTE=storagebox:doner-yedek
#
#   Backblaze B2 (kullandığın kadar, ~0,005 $/GB/ay):
#     BACKUP_REMOTE=b2:doner-yedek
BACKUP_REMOTE=
