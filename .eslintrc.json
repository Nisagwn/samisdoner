{
  // Arama burada durur.
  //
  // ESLint yapılandırmayı bulmak için dizinleri **yukarı doğru** tarar. Depo
  // bir git worktree'sinde açıldığında (ör. .claude/worktrees/<dal>/) üst
  // dizinlerde ana kopyanın .eslintrc.json'ı bulunuyor ve aynı eklenti iki
  // kez yüklendiği için lint hiç çalışmadan düşüyordu:
  // "Plugin @next/next was conflicted between ...". Bayrak, aramayı bu
  // dosyada keser; tek kopyada da doğru davranıştır, çünkü projenin kökü
  // burasıdır.
  "root": true,

  // Next'in önerdiği taban: erişilebilirlik (jsx-a11y), React kancaları ve
  // Core Web Vitals'ı bozan kalıplar. Ayrıca bir stil kuralı eklenmedi —
  // biçimlendirme tartışması kod incelemesinden alınıp araca verilecekse
  // bunun yeri Prettier'dır, lint değil.
  // Arama burada durur; üst dizinlerdeki yapılandırmalar okunmaz.
  //
  // Gerekçesi somut: git worktree'leri depo klasörünün İÇİNDE açıldığında
  // (.claude/worktrees/...) ESLint yukarı doğru yürüyüp ana kopyanın
  // .eslintrc.json dosyasını da buluyor ve aynı eklentiyi iki kez yüklemeye
  // çalışıp "Plugin @next/next was conflicted" ile düşüyor. Bayrak ayrıca
  // deponun dışında kalan bir yapılandırmanın buradaki kurallara sızmasını da
  // engelliyor.
  "root": true,

  "extends": ["next/core-web-vitals"],

  "ignorePatterns": [".next", ".next-dev", "node_modules", "public"],

  "rules": {
    // Markanın kendisi "SAMİ´S // DÖNER" — logodaki iki eğik çizgi JSX metni
    // içinde geçiyor ve bu kural onu unutulmuş bir "// yorum" sanıyor. Kuralın
    // yakaladığı gerçek hata (JSX'e yanlışlıkla yazılmış satır yorumu) nadir;
    // logo ise her sayfada. Kural açık kalsaydı her logo kullanımı bir
    // susturma satırı gerektirirdi.
    "react/jsx-no-comment-textnodes": "off",

    // Görsel <img> ile değil next/image ile konur: boyutlandırma, webp'e
    // çevirme ve tembel yükleme onun işi. Uyarı değil hata — kaçan bir <img>
    // mobil veride fark edilmeden megabaytlara mal olur.
    "@next/next/no-img-element": "error"
  }
}
