# Ortam değişkenleri şablonu.
#
# Bu dosyayı `.env.local` olarak kopyalayıp kendi değerlerinizi girin.
# `.env.local` .gitignore'daki *.local kuralıyla repoya girmez.
#
# Rastgele gizli anahtar üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------- admin paneli
# Panele giriş parolası. Canlıya çıkmadan önce mutlaka güçlü bir değerle değiştirin.
ADMIN_PASSWORD=degistir-beni
# Admin oturum çerezini imzalar. En az 16 karakter olmak zorunda.
ADMIN_SESSION_SECRET=en-az-16-karakterlik-rastgele-gizli-anahtar

# ------------------------------------------------------------------ veritabanı
# YEREL GELİŞTİRME: veritabanı Docker'da çalışır.
#
#   docker compose up -d          → Postgres + Redis ayağa kalkar
#   bun run db:push               → şemayı kur
#   bun run db:seed               → menüyü ve işletme bilgisini yaz
#
# Neden yerel: uzak Supabase'e (Frankfurt) her sorgu havuzlayıcı üzerinden
# ~450 ms, doğrudan bağlantıda ~87 ms sürüyordu. Bir sayfa birkaç sorgu attığı
# için geliştirme sırasında her tıklama saniyelerle ölçülüyordu. Aynı makinedeki
# Postgres'te bu ~1 ms.
#
# Aşağıdaki adres docker-compose.yml içindeki kullanıcı/parola ile eşleşir.
# İkisi de aynı olmak zorunda: lib/db.ts geliştirmede DIRECT_URL'i tercih eder.
DATABASE_URL="postgresql://doner:doner@127.0.0.1:5432/doner"
DIRECT_URL="postgresql://doner:doner@127.0.0.1:5432/doner"

# Havuz sınırı. Yerel Postgres'te bolca bağlantı var; boş bırakılırsa
# lib/db.ts içindeki varsayılan (5) geçerli olur.
DATABASE_CONNECTION_LIMIT=

# --- Supabase'e bağlanmak isterseniz (staging / eski düzen) --------------
# Bölge olarak Frankfurt (eu-central-1) seçin: veri Almanya'da kalsın (DSGVO).
# İKİ ayrı adres gerekir:
#  - DATABASE_URL: "Transaction pooler" (6543), sonuna ?pgbouncer=true
#  - DIRECT_URL:   "Direct connection" (5432), `prisma migrate` bunu kullanır
# Her ikisine de connect_timeout=30 ekleyin; Supavisor'ın el sıkışması
# 4-6 saniye sürebiliyor ve Prisma'nın 5 saniyelik sınırı bunu yanlışlıkla
# "P1001: Can't reach database server" diye raporluyor.
#
# DATABASE_URL="postgresql://postgres.<proje-ref>:<parola>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30"
# DIRECT_URL="postgresql://postgres.<proje-ref>:<parola>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?connect_timeout=30"

# -------------------------------------------------------------- önbellek
# Redis — paylaşımlı önbellek (lib/cache.ts). Menü, fiyat ayarları, çalışma
# saatleri ve teslimat bölgeleri burada tutulur.
#
# BOŞ BIRAKILABİLİR: tanımlı değilse önbellek yalnızca süreç içi bellekte
# çalışır ve uygulama yine doğru sonuç verir, sadece yeniden başlatmada
# önbellek boşalır. Yani Redis zorunlu değil, hızlandırıcıdır.
#
# docker compose up -d ile gelen Redis:
REDIS_URL="redis://127.0.0.1:6379"

# Önbellek anahtarlarının öneki. Saklanan verinin **biçimi** değiştiğinde
# artırın (v1 → v2): yeni kod eski JSON'u okuyup eksik alanlarla çalışmasın.
# Boş bırakılırsa "doner:v1" kullanılır.
CACHE_NAMESPACE=

# ----------------------------------------------------------- ödeme (Stripe)
# ŞU AN TEST MODU. Canlı anahtarlar (sk_live_/pk_live_) ancak Stripe hesabı
# doğrulandıktan sonra, canlıya alma fazında kullanılacak.
#
# Anahtarlar: Stripe Dashboard → sağ üstte "Test mode" açık → Developers → API keys
# Yalnızca gizli anahtar gerekir: ödeme oturumu sunucuda açılır ve müşteri
# Stripe'ın barındırdığı sayfaya yönlendirilir. Tarayıcıda Stripe.js
# çalışmadığı için yayımlanabilir anahtar (pk_...) hiçbir yerde kullanılmıyor.
STRIPE_SECRET_KEY=sk_test_...

# Webhook imza anahtarı.
#
# Yerel geliştirmede olayları makinenize taşıyan köprüyü açın:
#   npm run dev:stripe        (dev sunucusu ayrı bir terminalde açıkken)
# Bu komut Stripe CLI'yi yukarıdaki test anahtarıyla çalıştırır ("stripe login"
# gerekmez) ve buradaki değeri kendi imza anahtarıyla eşitler.
#
# Köprü açık DEĞİLKEN ödeme alınır ama olay hiç ulaşmaz. Sipariş o durumda
# müşteri takip sayfasına döndüğünde yapılan mutabakatla kurtarılır
# (lib/orders/reconcile.ts) — yine de asıl yol webhook'tur, köprüyü açın.
#
# Canlıda bu değer Stripe Dashboard → Developers → Webhooks altında oluşturulan
# uca (https://<alan-adiniz>/api/webhooks/stripe) ait imza anahtarıdır.
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------ uygulama
# Stripe'ın ödeme sonrası geri döneceği adres ve e-postalardaki bağlantılar
# bu adresten üretilir. Canlıda kendi alan adınız olacak.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Müşteri sipariş takip bağlantısını (/bestellung/...) imzalar.
# Admin anahtarından **ayrı** olmalı: takip linki müşteriye gider, admin gizli
# anahtarı hiçbir zaman gitmez.
ORDER_TOKEN_SECRET=en-az-16-karakterlik-rastgele-gizli-anahtar

# ------------------------------------------------------- e-posta (opsiyonel)
# Tanımlı değilse e-posta gönderimi sessizce atlanır; sipariş akışı ve panel
# yine çalışır. resend.com üzerinden ücretsiz bir anahtar alınabilir.
RESEND_API_KEY=
# Yeni sipariş bildiriminin gideceği işletme adresi.
ORDER_NOTIFY_EMAIL=
# Giden e-postalarda görünecek gönderen. Alan adı Resend'de doğrulanmış olmalı.
ORDER_MAIL_FROM="Sami's Döner <bestellung@example.de>"

# ------------------------------------------------ geliştirme (canlıda OLMAMALI)
# "true" ise çalışma saati kontrolü atlanır: dükkân kapalıyken de sipariş
# verilebilir. Sipariş akışını gece test edebilmek için. Her atlamada sunucu
# günlüğüne uyarı düşer.
#
# Canlıya çıkmadan önce bu satırı ortamdan KALDIRIN — açık kalırsa müşteri
# gerçekten kapalıyken sipariş verir ve ödemesi tahsil edilir.
ORDERS_IGNORE_OPENING_HOURS=false

# ------------------------------------------------------------ müşteri hesabı
# Müşteri oturum çerezini imzalar. Admin anahtarından **ayrı** olmak zorunda:
# bu jeton binlerce müşterinin tarayıcısında dolaşır, admin jetonu bir kişinin.
# Değeri değiştirmek tüm müşterileri çıkış yaptırır (zararsız, sadece rahatsız).
CUSTOMER_SESSION_SECRET=en-az-16-karakterlik-rastgele-gizli-anahtar

# ----------------------------------------------------------- yasal (Impressum)
# DDG § 5 uyarınca zorunlu alanlar. BOŞ BIRAKILIRSA /impressum sayfasında
# kırmızı uyarı çıkar ve site fiilen Impressum'suz sayılır (Abmahnung riski).
# Bunlar uydurulamaz — işletmenin gerçek bilgileri girilmeli.
LEGAL_COMPANY_NAME=
# Temsile yetkili kişi (şahıs işletmesinde sahibin adı soyadı).
LEGAL_REPRESENTATIVE=
# § 5 Abs. 1 Nr. 2 DDG: e-posta zorunludur.
LEGAL_CONTACT_EMAIL=
# § 27a UStG: USt-IdNr. Yoksa boş bırakın (o zaman uyarı çıkar; vergi
# dairesinden alınması gerekir).
LEGAL_VAT_ID=
# Gıda denetiminden sorumlu makam. Varsayılan Straubing-Bogen ilçesidir.
LEGAL_SUPERVISORY_AUTHORITY=
# DSGVO Art. 13: veri koruma ile ilgili başvurulacak adres.
LEGAL_PRIVACY_CONTACT=
# Ticaret sicili kaydı (şahıs işletmesinde yoktur, boş bırakılabilir).
LEGAL_REGISTER_ENTRY=

# ------------------------------------------------------- bakım görevi (cron)
# /api/cron/expire-orders ucunu koruyan gizli anahtar. Zamanlamayı canlıda
# `docker-compose.prod.yml` içindeki `cron` servisi yapar (15 dakikada bir) ve
# isteği Authorization: Bearer <bu değer> başlığıyla gönderir.
#
# BOŞ BIRAKILIRSA uç 503 döner ve tarama HİÇ çalışmaz: ödemeden vazgeçen
# müşterinin siparişi sonsuza kadar "ödeme bekleniyor"da kalır, panelde çöp
# birikir ve sipariş numarası boşuna tüketilir. Canlıya almadan önce doldurun.
#   openssl rand -hex 32
CRON_SECRET=

# bun kullaniliyor; npm lockfile i olusursa Next in hatali lockfile yamasini kapatir
NEXT_IGNORE_INCORRECT_LOCKFILE=1
