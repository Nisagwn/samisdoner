{
  "name": "the-doner",
  "private": true,
  "version": "0.1.0",
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "sharp"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "data:areas": "tsx scripts/scrape-delivery-areas.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:flow": "tsx scripts/verify-flow.ts",
    "dev:webpack": "node scripts/dev.mjs --webpack",
    "clean": "node -e \"for (const d of ['.next','.next-dev']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "dev:stripe": "node scripts/stripe-listen.mjs",
    "docker:dev": "docker compose up -d",
    "docker:dev:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.prod logs -f",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.prod down"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "ioredis": "^5.4.1",
    "lenis": "^1.1.13",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.26.0",
    "sharp": "^0.33.5",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.41",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.9",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
